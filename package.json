{
  "name": "sn-markdown",
  "version": "0.3.0",
  "description": "Markdown editor plugin for Standard Notes",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "package": "node scripts/package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/language-data": "6.5.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@mdit/plugin-tasklist": "1.1.3",
    "dompurify": "3.4.17",
    "markdown-it": "15.0.3",
    "sn-extension-api": "0.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
